{
  "builds": [
    {
      "src": "Django-CRM-main/src/cfehome/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "Django-CRM-main/src/local-cdn" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/Django-CRM-main/src/local-cdn/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Django-CRM-main/src/cfehome/wsgi.py"
    }
  ]
}
